# Copy to .env (in this folder or backend/) and fill in what you have. Every key is optional:
# with none, the app runs in clearly-labelled demo mode.

# --- AI model -----------------------------------------------------------------------------
# auto = anthropic (if ANTHROPIC_API_KEY) -> claude_cli (if the Claude Code CLI is installed and
#        signed in) -> demo.  Force one with: anthropic | claude_cli | demo
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Claude Code CLI fallback (uses your local Claude Code login, no API key needed)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
LLM_TIMEOUT_SECONDS=600

# --- Research -----------------------------------------------------------------------------
# Web search order: Tavily -> Claude web search (API key or CLI) -> DuckDuckGo (best effort)
TAVILY_API_KEY=
# YouTube Data API v3; without it the public results page is parsed and every video is
# confirmed via YouTube oEmbed
YOUTUBE_API_KEY=
# Google Books; without it Open Library (no key) is used
GOOGLE_BOOKS_API_KEY=
# 1 = skip all network research
RESEARCH_OFFLINE=0

# --- Server -------------------------------------------------------------------------------
DATABASE_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
